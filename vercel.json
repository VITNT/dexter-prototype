{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "fluid": true,
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    },
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{images/**,models/**,docs/**,tools/**,src/pipeline/*.test.mjs,asl_service/tests/**,third_party/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=()"
        }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
